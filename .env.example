# Supabase → Connect → ORM → Prisma.
# Runtime/serverless connection through the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migration connection through the session/direct endpoint (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[publishable key]"
# Server-only — never expose to the client. Used to upload catalog images to
# Supabase Storage on behalf of the app.
SUPABASE_SERVICE_ROLE_KEY="[secret key]"

# Optional server-only AI integrations. Missing keys mean the corresponding
# evidence is omitted and the remaining recommendation weights are normalized;
# the app never fabricates a trend score.
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""
