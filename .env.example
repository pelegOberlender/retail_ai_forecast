# Supabase → Connect → Session pooler (port 5432).
# This works for Prisma migrations and the local Next.js server. A dedicated
# transaction-pooler value will be configured later for serverless deployment.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key]"
# Server-only — never expose to the client. Used to upload catalog images to
# Supabase Storage on behalf of the app.
SUPABASE_SERVICE_ROLE_KEY="[service_role secret key]"

# Optional server-only AI integrations. Missing keys mean the corresponding
# evidence is omitted and the remaining recommendation weights are normalized;
# the app never fabricates a trend score.
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""
